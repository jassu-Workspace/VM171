# ─── Dependencies ────────────────────────────────────────────────
node_modules/

# ─── Build output ────────────────────────────────────────────────
extension/.output/
extension/.wxt/
.wxt/
dist/
build/
*.tsbuildinfo

# ─── Secrets — NEVER commit ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
server/.secret

# ─── Runtime session artifacts (contain un-redacted screenshots) ──
storage/sessions/
storage/*.log
# Cycle 3.8: server_logs.jsonl holds UN-REDACTED maskedDom captures and was
# committed with 7 real third-party email addresses (commit 8dec66fe).
# The existing rules covered storage/*.log but not *.jsonl.
storage/*.jsonl

# ─── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Python / notebooks ──────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ─── Test artifacts ──────────────────────────────────────────────
coverage/
tests/fixtures/mock_scenarios_150.json

