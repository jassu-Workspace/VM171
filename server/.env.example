# ─── Zero-Trust AI Web Agent — server configuration ───────────────
# Copy to server/.env and fill in. NEVER commit the filled copy.
#
# ATTENTION OPERATORS AND DEVELOPERS:
# Every configuration variable documented in this file is read at boot or runtime.
# A variable that is documented but not wired into code is worse than an
# undocumented one: operators trust documented settings to enforce security,
# resource bounds, and network restrictions. If the code silently ignores a
# documented setting, that trust becomes a silent failure or vulnerability.
# Every variable below is honored by the server implementation.

# ── Network ─────────────────────────────────────────────────────
PORT=3000
# Loopback only. The server must never be reachable off-box.
HOST=127.0.0.1
# ENFORCED, not just documented (Cycle 3.9). A non-loopback value here is
# REFUSED and logged, and the server binds 127.0.0.1 anyway. HOST used to
# be ignored entirely while this file claimed the server was loopback-
# only; it answered on the LAN address. The control is now real.

# ── Authentication (Cycle 2.4 — bearer tokens) ───────────────────
# The shared SECRET_PASSWORD is GONE. The server now issues HS256 bearer
# tokens. On boot it generates a random signing key and a one-time pairing
# code, prints the pairing code to the console, and exchanges the pairing code
# for a 15-minute token at POST /api/auth/pair. The extension keeps the token in
# chrome.storage.local and sends `Authorization: Bearer <jwt>`.
#
# Nothing here is a credential you need to set by hand in normal operation.
# These two exist so an automated harness can supply known values.
SECRETS_SIGNING_KEY=
SECRETS_PAIRING_CODE=

# Retained ONLY so the logger-redaction tests have a realistic secret to prove
# is never written to a log. It is NOT an authentication credential.
# However, the server verifies its presence at boot (unless running in test mode).
SECRET_PASSWORD=

# Comma-separated exact origins permitted to call the API.
# Required values:
#   chrome-extension://<your-pinned-extension-id>
#   http://localhost:3300            (WXT dev server)
# Requests carrying any other Origin are rejected with 403 before auth.
ALLOWED_ORIGINS=

# ── AI provider (Priority 1: direct Google Gemini) ───────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── AI provider (Priority 2: 9router fallback) ──────────────────
# WARNING: this relay receives masked DOM + redacted images.
# Use only a host you control and trust.
ROUTER_API_KEY=
ROUTER_URL=
MODEL_NAME=ag/gemini-3.7-flash-high

# ── Redaction policy ────────────────────────────────────────────
# off  = accept a degraded (un-redacted) image but record + surface it
# true = reject any image that was not verified-redacted (hard block)
REJECT_UNREDACTED=false

# ── Observability & Logging ─────────────────────────────────────
# Cycle 2.11: the DEFAULT telemetry response is operational only (liveness,
# uptime, heap, session counts, redaction accounting). Setting this to true
# re-exposes the host fingerprint — cpuModel, loadAvg, platform, arch and the
# full memory breakdown. Keep it false anywhere the endpoint could be reached
# by anyone but the operator.
TELEMETRY_VERBOSE=false
# json | pretty
# Controls stdout/stderr formatting. 'pretty' outputs colored human-readable
# log lines; 'json' outputs one JSON object per line. Defaults to 'pretty'.
LOG_FORMAT=pretty

# ── Resource budgets & Rate limiting ────────────────────────────
# Maximum allowed JSON request body size in bytes (default 20MB = 20971520).
# Validated as a positive number; falls back to default on invalid input.
MAX_BODY_BYTES=20971520

# Rate limit requests per window per IP (default 40).
RATE_LIMIT_MAX_REQUESTS=40

# Rate limit sliding window duration in milliseconds (default 60000 = 1 minute).
RATE_LIMIT_WINDOW_MS=60000

# Maximum steps permitted per task execution before the action policy enforces
# a stop (default 35). Validated as a positive number.
MAX_STEPS=35

# Maximum tokens the upstream model may generate per step (default 4096).
# Bounds provider spend across both direct Gemini and 9router fallback calls.
# Validated as a positive integer; falls back to default on invalid input.
MAX_OUTPUT_TOKENS=4096

# ── Session Storage & Retention ─────────────────────────────────
# Directory where session artifacts (screenshots, metadata, prompts) are saved.
# When unset, defaults to `<server_root>/../storage/sessions`.
SESSION_STORAGE_DIR=

# Retention period in days for pruning stored sessions (default 7).
# Used by pruneSessions() to delete sessions whose updatedAt/createdAt exceeds this age.
SESSION_RETENTION_DAYS=7

# Maximum number of stored sessions to keep on disk (default 100).
# Used by pruneSessions() to enforce a disk cap by evicting oldest sessions first.
MAX_SESSIONS=100

# ── Diagnostics & Runtime Environment ───────────────────────────
# Diagnostic wire tracing: set to 1 or true to emit raw request method, path,
# and content-length directly to stderr before any middleware (including bodyLimit
# and CORS). Useful for diagnosing 413 rejections. Unset by default.
WIRE_TRACE=

# Runtime environment (production | development | test). In test mode, boot
# requirements and exit handlers are bypassed so test harnesses can import app.
NODE_ENV=production

# Vitest test runner flag. Set automatically by Vitest to signal that the server
# is being imported by a test harness rather than started directly.
VITEST=
