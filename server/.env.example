# ─── Zero-Trust AI Web Agent — server configuration ───────────────
# Copy to server/.env and fill in. NEVER commit the filled copy.

# ── Network ─────────────────────────────────────────────────────
PORT=3000
# Loopback only. The server must never be reachable off-box.
HOST=127.0.0.1

# ── Authentication ──────────────────────────────────────────────
# Leave blank on first boot: the server generates a 43-char base64url
# secret, writes it to server/.secret (mode 0600, gitignored) and
# prints a pairing payload. Paste that payload into the extension's
# Options page. To rotate, delete server/.secret and restart.
SECRET_PASSWORD=

# Comma-separated exact origins permitted to call the API.
# Required values:
#   chrome-extension://<your-pinned-extension-id>
#   http://localhost:3300            (WXT dev server)
# Requests carrying any other Origin are rejected with 403 before auth.
ALLOWED_ORIGINS=

# ── AI provider (Priority 1: direct Google Gemini) ───────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── AI provider (Priority 2: 9router fallback) ──────────────────
# WARNING: this relay receives masked DOM + redacted images.
# Use only a host you control and trust.
ROUTER_API_KEY=
ROUTER_URL=
MODEL_NAME=

# ── Redaction policy ────────────────────────────────────────────
# off  = accept a degraded (un-redacted) image but record + surface it
# true = reject any image that was not verified-redacted (hard block)
REJECT_UNREDACTED=false

# ── Observability ───────────────────────────────────────────────
# Cycle 2.11: the DEFAULT telemetry response is operational only (liveness,
# uptime, heap, session counts, redaction accounting). Setting this to true
# re-exposes the host fingerprint — cpuModel, loadAvg, platform, arch and the
# full memory breakdown. Keep it false anywhere the endpoint could be reached
# by anyone but the operator.
TELEMETRY_VERBOSE=false
# json | pretty
LOG_FORMAT=pretty

# ── Resource budgets ────────────────────────────────────────────
MAX_BODY_BYTES=20971520
RATE_LIMIT_MAX_REQUESTS=40
MAX_STEPS=35
SESSION_RETENTION_DAYS=7
MAX_SESSIONS=100
